{
  "manifest_version": 3,
  "name": "LearnTube AI",
  "version": "1.0.0",
  "description": "Floating AI companion for YouTube learning.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "*://learntube-api.production.com/*"]
}
